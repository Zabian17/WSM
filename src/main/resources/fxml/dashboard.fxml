<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.tugas_akhir.DashboardController"
            prefWidth="1200" prefHeight="720"
            stylesheets="@../css/dashboard.css">

    <!-- SIDEBAR (LEFT) -->
    <left>
        <VBox styleClass="sidebar" spacing="0">

            
            <VBox spacing="0" style="-fx-padding: 20 16 16 16;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <StackPane styleClass="sidebar-logo-box">
                        <Label text="G" styleClass="sidebar-logo-text"/>
                    </StackPane>
                    <VBox spacing="1">
                        <Label text="GudangKu" styleClass="sidebar-app-name"/>
                        <Label text="Warehouse Management" style="-fx-font-size:9px; -fx-text-fill: #9ba3b8;"/>
                    </VBox>
                </HBox>
            </VBox>

            
            <Pane styleClass="sidebar-divider"/>

            <VBox spacing="4" style="-fx-padding: 14 15 14 15;">

                
                <HBox fx:id="navDashboard" styleClass="nav-item-active" spacing="10" alignment="CENTER_LEFT"
                      onMouseClicked="#handleNavDashboard">
                    <Label text="⊞" styleClass="nav-icon-active"/>
                    <Label text="Dashboard" styleClass="nav-label-active"/>
                </HBox>

                
                <HBox fx:id="navStorage" styleClass="nav-item" spacing="10" alignment="CENTER_LEFT"
                      onMouseClicked="#handleNavStorage">
                    <Label text="▦" styleClass="nav-icon"/>
                    <Label text="Barang" styleClass="nav-label"/>
                </HBox>

                <!-- Divider -->
                <Pane styleClass="sidebar-divider" style="-fx-margin: 6 0 6 0;"/>

                
                <HBox fx:id="navMovements" styleClass="nav-item" spacing="10" alignment="CENTER_LEFT"
                      onMouseClicked="#handleNavMovements">
                    <Label text="↔" styleClass="nav-icon"/>
                    <Label text="Pergerakan" styleClass="nav-label"/>
                </HBox>

                
                <HBox fx:id="navCustomer" styleClass="nav-item" spacing="10" alignment="CENTER_LEFT"
                      onMouseClicked="#handleNavCustomer">
                    <Label text="○" styleClass="nav-icon"/>
                    <Label text="Pelanggan" styleClass="nav-label"/>
                </HBox>

                
                <HBox fx:id="navReport" styleClass="nav-item" spacing="10" alignment="CENTER_LEFT"
                      onMouseClicked="#handleNavReport">
                    <Label text="≡" styleClass="nav-icon"/>
                    <Label text="Laporan" styleClass="nav-label"/>
                </HBox>

                
                <Pane styleClass="sidebar-divider"/>

                
                <HBox fx:id="navSetting" styleClass="nav-item" spacing="10" alignment="CENTER_LEFT"
                      onMouseClicked="#handleNavSetting">
                    <Label text="⚙" styleClass="nav-icon"/>
                    <Label text="Pengaturan" styleClass="nav-label"/>
                </HBox>

            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            
            <VBox style="-fx-padding: 0 15 16 15;">
                <Pane styleClass="sidebar-divider"/>
                <HBox styleClass="nav-item" spacing="10" alignment="CENTER_LEFT"
                      onMouseClicked="#handleLogout" style="-fx-padding: 8 12 8 12; -fx-margin: 6 0 0 0;">
                    <Label text="⏻" style="-fx-text-fill:#ef4444; -fx-font-size:15px; -fx-min-width:22px; -fx-alignment:center;"/>
                    <Label text="Logout" style="-fx-text-fill:#ef4444; -fx-font-size:13px;"/>
                </HBox>
            </VBox>

        </VBox>
    </left>

    <!-- MAIN CONTENT (CENTER) -->
    <center>
        <VBox>

            
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="12"
                  style="-fx-padding: 0 20 0 24;">

                <Label fx:id="pageTitleLabel" text="Dashboard" styleClass="page-title"/>

                <Region HBox.hgrow="ALWAYS"/>

                
                <Button styleClass="icon-btn" text="!" onAction="#handleNotification"/>

                
                <StackPane fx:id="topbarAvatarStack"
                           styleClass="topbar-avatar-stack"
                           onMouseClicked="#handleSettingShortcut"
                           style="-fx-cursor: hand;">
                    
                    <ImageView fx:id="topbarAvatarImg"
                               fitWidth="34" fitHeight="34"
                               preserveRatio="false"
                               visible="false" managed="false">
                        <clip>
                            <Circle centerX="17" centerY="17" radius="17"/>
                        </clip>
                    </ImageView>
                    
                    <StackPane fx:id="topbarAvatarFallback" styleClass="avatar-btn">
                        <Label fx:id="topbarAvatarLabel" text="A" styleClass="avatar-label"/>
                    </StackPane>
                </StackPane>

            </HBox>

            <!-- PAGE CONTENT (scrollable) -->
            <ScrollPane fx:id="mainScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS">
                <content>
                    <VBox styleClass="content-area" spacing="16">

                        <VBox styleClass="card" spacing="12">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <VBox spacing="2">
                                    <Label text="Kinerja Operasional" styleClass="card-title"/>
                                    <Label fx:id="warehouseMetricRange" text="Memuat ringkasan 30 hari terakhir..."
                                           style="-fx-font-size:11px; -fx-text-fill:#748198;"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <HBox alignment="CENTER_RIGHT" spacing="6">
                                    <ComboBox fx:id="warehouseMetricPeriod" prefWidth="130"
                                              onAction="#handleWarehousePeriodChanged"/>
                                    <DatePicker fx:id="warehouseMetricFrom" prefWidth="125"
                                                promptText="Dari" visible="false" managed="false"/>
                                    <DatePicker fx:id="warehouseMetricTo" prefWidth="125"
                                                promptText="Sampai" visible="false" managed="false"/>
                                    <Button fx:id="warehouseTargetButton" text="Atur target" styleClass="btn-outline"
                                            visible="false" managed="false" onAction="#handleConfigureWarehouseTargets"/>
                                    <Button text="Terapkan" styleClass="btn-outline"
                                            onAction="#handleRefreshWarehouseMetrics"/>
                                </HBox>
                            </HBox>
                            <FlowPane fx:id="warehouseMetricsPane" hgap="12" vgap="12" alignment="TOP_LEFT"/>
                        </VBox>

                        <!-- ROW 1: Dynamic Section Overview + Right Panel -->
                        <HBox spacing="16">

                            <!-- Section Overview Card (DYNAMIC SECTIONS) -->
                            <VBox styleClass="card" spacing="14" HBox.hgrow="ALWAYS">

                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <VBox spacing="1">
                                        <Label text="Section Overview &amp; Storage Alert" styleClass="card-title"/>
                                        <Label text="Pantau kapasitas dan peringatan pada setiap section gudang." style="-fx-font-size:11px; -fx-text-fill: #748198;"/>
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Muat Ulang" styleClass="btn-outline" onAction="#handleRefreshSections"/>
                                    <Button text="+ Tambah Section" styleClass="btn-primary" onAction="#handleTambahSection"/>
                                </HBox>

                                <!-- DYNAMIC SECTIONS CONTAINER -->
                                <FlowPane fx:id="sectionsFlowPane" hgap="16" vgap="16" alignment="TOP_LEFT"/>
                            </VBox>

                            <!-- Right column: Recent Activity + Recent Transaction -->
                            <VBox spacing="16" style="-fx-pref-width: 320px; -fx-min-width: 300px; -fx-max-width: 340px;">

                                
                                <VBox styleClass="card" spacing="12">
                                    <HBox alignment="CENTER_LEFT" spacing="8">
                                        <Label text="Aktivitas Terbaru" styleClass="card-title"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="24H" styleClass="card-badge"/>
                                    </HBox>

                                    <HBox spacing="12" alignment="CENTER_LEFT">
                                        <!-- Barang Masuk -->
                                        <VBox styleClass="activity-card-in" spacing="4" HBox.hgrow="ALWAYS">
                                            <HBox alignment="CENTER_LEFT" spacing="8">
                                                <Label text="+" styleClass="activity-icon-in"/>
                                                <Label text="↗" style="-fx-text-fill:#10b981; -fx-font-size:14px;"/>
                                            </HBox>
                                            <Label fx:id="lblBarangMasuk" text="0" styleClass="activity-number-in"/>
                                            <Label text="Barang Masuk" styleClass="activity-label"/>
                                        </VBox>

                                        <!-- Barang Keluar -->
                                        <VBox styleClass="activity-card-out" spacing="4" HBox.hgrow="ALWAYS">
                                            <HBox alignment="CENTER_LEFT" spacing="8">
                                                <Label text="−" styleClass="activity-icon-out"/>
                                                <Label text="↗" style="-fx-text-fill:#ef4444; -fx-font-size:14px;"/>
                                            </HBox>
                                            <Label fx:id="lblBarangKeluar" text="0" styleClass="activity-number-out"/>
                                            <Label text="Barang Keluar" styleClass="activity-label"/>
                                        </VBox>
                                    </HBox>
                                </VBox>

                                <!-- Top Movers Card -->
                                <VBox styleClass="card" spacing="10">
                                    <HBox alignment="CENTER_LEFT" spacing="8">
                                        <Label text="Info Gudang" styleClass="card-title"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="Langsung" styleClass="card-badge"/>
                                    </HBox>
                                    <Label text="Setiap section memiliki batas peringatan tersendiri. Gunakan pengaturan section untuk mengubahnya." wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                                </VBox>

                            </VBox>
                        </HBox>

                    </VBox>
                </content>
            </ScrollPane>

        </VBox>
    </center>

</BorderPane>
